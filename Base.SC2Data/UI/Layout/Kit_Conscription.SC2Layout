<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<Desc>
    <Constant name="ConscriptionItemButtonAvailable" val="00ffff"/>
    <Constant name="ConscriptionItemButtonAvailablePressed" val="00ff00"/>

    <Constant name="ConscriptionItemButtonPurchased" val="4b7c8d"/>
    <Constant name="ConscriptionItemButtonPurchasedPressed" val="00ff00"/>

    <Constant name="ConscriptionItemButtonInsufficient" val="ab3131"/>
    <Constant name="ConscriptionItemButtonInsufficientPressed" val="00ff00"/>

    <Constant name="ConscriptionGroupButtonAvailable" val="00ffff"/>
    <Constant name="ConscriptionGroupButtonAvailablePressed" val="00ff00"/>

    <Constant name="ConscriptionGroupButtonPurchased" val="4b7c8d"/>
    <Constant name="ConscriptionGroupButtonPurchasedPressed" val="00ff00"/>

    <Constant name="ConscriptionGroupButtonInsufficient" val="ab3131"/>
    <Constant name="ConscriptionGroupButtonInsufficientPressed" val="00ff00"/>

    <Constant name="ConscriptionGroupTextAvailable" val="3da7a1"/>
    <Constant name="ConscriptionGroupTextAvailablePressed" val="ffffff"/>

    <Constant name="ConscriptionGroupTextPurchased" val="4b7c8d"/>
    <Constant name="ConscriptionGroupTextPurchasedPressed" val="ffffff"/>

    <Constant name="ConscriptionGroupTextInsufficient" val="bb2800"/>
    <Constant name="ConscriptionGroupTextInsufficientPressed" val="ffffff"/>
    
    <Constant name="PurchasePanelCostAvailable" val="00fd00"/>
    <Constant name="PurchasePanelCostPurchased" val="4b7c8d"/>
    <Constant name="PurchasePanelCostInsufficient" val="ab3131"/>
    
    <Frame type="Frame" name="ConscriptionPanelTemplate">
        <Anchor side="Top" relative="$parent" pos="Min" offset="0"/>
        <Anchor side="Left" relative="$parent" pos="Mid" offset="0"/>
        <Anchor side="Right" relative="$parent" pos="Mid" offset="0"/>
        <Width val="1600"/>
        <Height val="1200"/>

        <Frame type="StandardTooltip" name="PurchasePanelTooltip" template="StandardTooltip/StandardStoryModeTooltipTemplate"/>

        <Frame type="Image" name="BackgroundMaskImage">
            <Anchor side="Top" relative="$parent" pos="Min" offset="0"/>
            <Anchor side="Bottom" relative="$parent" pos="Max" offset="0"/>
            <Anchor side="Left" relative="$parent" pos="Min" offset="0"/>
            <Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
            <Texture val="@@UI/PauseScreenDimImage"/>
            <RenderType val="HDR"/>
        </Frame>

        <Frame type="Portrait" name="BackgroundPortrait">
            <Anchor side="Top" relative="$parent" pos="Min" offset="80"/>
            <Anchor side="Bottom" relative="$parent" pos="Max" offset="-80"/>
            <Anchor side="Left" relative="$parent" pos="Min" offset="80"/>
            <Anchor side="Right" relative="$parent" pos="Max" offset="-80"/>
            <BackgroundImage val="BackgroundPortraitBackgroundImage"/>
            <BorderImage val="BackgroundPortraitBorderImage"/>
            <AcceptsMouse val="false"/>
            <UseTransition val="false"/>
            <UseAlternateTime val="false"/>
            <ModelLink val="TechBackDrop"/>
            
            <Frame type="Image" name="BackgroundPortraitBorderImage">
                <Visible val="false"/>
                <DescFlags val="Internal"/>
            </Frame>

            <Frame type="Image" name="BackgroundPortraitBackgroundImage">
                <Visible val="false"/>
                <DescFlags val="Internal"/>
            </Frame>
        </Frame>
        
        <Frame type="Label" name="TitleLabel">
            <Anchor side="Top" relative="$parent" pos="Min" offset="120"/>
            <Anchor side="Left" relative="$parent" pos="Min" offset="690"/>
            <Anchor side="Right" relative="$parent" pos="Max" offset="-330"/>
            <Style val="CampaignPanelTitle"/>
            <Alpha val="120"/>
            <Text val="@UI/PurchasePanelTitle"/>
        </Frame>

        <Frame type="Frame" name="SelectionInfoFrame"> 
            <Handle val="Kit_Conscription_SelectionInfoFrame"/>
            <Anchor side="Top" relative="$parent/CategoryBorderImage" pos="Max" offset="50"/>
            <Anchor side="Bottom" relative="$parent" pos="Max" offset="-65"/>
            <Anchor side="Left" relative="$parent" pos="Min" offset="50"/>
            <Anchor side="Right" relative="$parent" pos="Max" offset="-50"/>

            <Frame type="Image" name="DescriptionBackgroundImage">
                <Anchor side="Top" relative="$parent" pos="Min" offset="0"/>
                <Anchor side="Bottom" relative="$parent" pos="Max" offset="-40"/>
                <Anchor side="Left" relative="$parent" pos="Min" offset="20"/>
                <Anchor side="Right" relative="$parent" pos="Mid" offset="-132"/>
                <Texture val="@@UI/CampaignPanelDescriptionBackground" layer="0"/>
                <TextureType val="HorizontalBorder"/>
                <Tiled val="true"/>
            </Frame>
    
            <Frame type="Image" name="DescriptionBottomImage">
                <Anchor side="Top" relative="$parent/DescriptionBackgroundImage" pos="Max" offset="-20"/>
                <Anchor side="Left" relative="$parent" pos="Min" offset="65"/>
                <Texture val="@@UI/CampaignPanelDescriptionBottom" layer="0"/>
                <TextureCoords top="0.0" left="1.0" bottom="1.0" right="0.0"/>
                <LayerColor val="7ed2e9"/>
            </Frame> 

            <Frame type="Label" name="NameLabel">
                <Anchor side="Top" relative="$parent/DescriptionBackgroundImage" pos="Min" offset="30"/>
                <Anchor side="Left" relative="$parent/DescriptionBackgroundImage" pos="Min" offset="25"/>
                <Style val="PurchasePanelSelectedPurchaseItemName"/>
                <Alpha val="170"/>
                <Text val="Name"/>
            </Frame>

            <Frame type="CashPanel" name="Credits">
                <Anchor side="Top" relative="$parent" pos="Min" offset="55"/>
                <Anchor side="Left" relative="$parent/DescriptionBackgroundImage" pos="Max" offset="-15"/>
                <Anchor side="Right" relative="$parent/MovieBackgroundImage" pos="Min" offset="15"/>
                <Height val="90"/>

                <Frame type="Image" name="BackgroundFrame">
                    <Anchor relative="$parent" />
                    <Texture val="@@UI/CampaignPanelCreditsBackground" layer="0"/>
                    <TextureType val="Border" layer="0"/>
                    <LayerColor val="86d7ec" layer="0"/>
                    <Tiled val="true" layer="0"/>
                </Frame>

                <Frame type="Label" name="CashLabel">
                    <Anchor side="Top" relative="$parent" pos="Min" offset="15"/>
                    <Anchor side="Left" relative="$parent" pos="Min" offset="10"/>
                    <Anchor side="Right" relative="$parent" pos="Max" offset="-10"/>
                    <Style val="CampaignPanelSelectionInfoCreditsHeading"/>
                    <Text val="@UI/CampaignPanelCreditsHeading"/>
                </Frame>

                <Frame type="CountdownLabel" name="CashAmountLabel">
                    <Anchor side="Top" relative="$parent/CashLabel" pos="Max" offset="0"/>
                    <Anchor side="Left" relative="$parent" pos="Min" offset="10"/>
                    <Anchor side="Right" relative="$parent" pos="Max" offset="-10"/>
                    <Style val="CampaignPanelSelectionInfoCredits"/>
                    <Alpha val="170"/>
                </Frame>
            </Frame>
        </Frame>

        <Frame type="Image" name="FullscreenBackgroundImage">
            <Anchor side="Top" relative="$parent" pos="Min" offset="0"/>
            <Anchor side="Left" relative="$parent" pos="Mid" offset="0"/>
            <Anchor side="Right" relative="$parent" pos="Mid" offset="0"/>
            <Texture val="@UI/PurchasePanelBackground" layer="0"/>
            <Unclipped val="true"/>
        </Frame>
        
        <Frame type="Button" name="CloseButton" template="StandardTemplates/StandardLargePanelRightButtonTemplate">
            <Handle val="Kit_Conscription_CloseButton"/>
            <Anchor side="Bottom" relative="$parent" pos="Max" offset="0"/>
            <Anchor side="Right" relative="$parent" pos="Max" offset="-20"/>
            <Shortcut val="Escape"/>
            <Shortcut val="@UI/Back_Hotkey"/>
            <Text val="@UI/Back_Control"/>

            <Frame type="Image" name="BackgroundImage">
                <Visible val="false"/>
            </Frame>
        </Frame>

        <Frame type="Button" name="ResetButton" template="StandardTemplates/StandardLargePanelRightButtonTemplate">
            <Handle val="Kit_Conscription_ResetButton"/>
            <Anchor side="Bottom" relative="$parent" pos="Max" offset="0"/>
            <Anchor side="Right" relative="$parent/CloseButton" pos="Min" offset="158"/>
            <Shortcut val="@UI/Reset_Hotkey"/>
            <Text val="@UI/Reset_Control"/>

            <Frame type="Image" name="BackgroundImage">
                <Visible val="false"/>
            </Frame>
        </Frame>
    </Frame>
</Desc>

